    "lucide-react": "^1.13.0",
    "next": "^16.4.6",
    "next-intl": "^4.16.0",
    "postgres": "^3.4.9",
    "posthog-js": "^1.454.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
