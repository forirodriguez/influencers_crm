# Local Postgres. `npm run db:up` si tenés Docker; si no, un Postgres 16 en 127.0.0.1.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/influencers_crm
DATABASE_URL_APP=postgres://app_user:app_user_local@127.0.0.1:5432/influencers_crm
DATABASE_URL_JOBS=postgres://app_jobs:app_jobs_local@127.0.0.1:5432/influencers_crm

# Sesión propia. En producción usá un secreto largo y distinto del de cifrado.
AUTH_SECRET=dev-only-auth-secret-change-me
AUTH_MODE=local
AUTH_DEV_EXPOSE_LINKS=true

# 32 bytes en base64. Solo para desarrollo: 0123456789abcdef0123456789abcdef
TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
INTEGRATIONS_MODE=mock
EMAIL_FROM=influencers_crm <noreply@localhost>

# Placeholders. La app arranca sin estos valores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=dev-whatsapp-secret
WHATSAPP_VERIFY_TOKEN=dev-verify-token
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
